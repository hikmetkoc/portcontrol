{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortControl",
  "version": "0.4.0",
  "identifier": "com.portcontrol.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortControl",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "backgroundColor": "#05060d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Neon geliştirme projesi ve port komuta merkezi",
    "longDescription": "Geliştirme projelerinin açtığı portları canlı izler, çalışma klasöründeki frontend/backend uygulamalarını tespit eder, tek tıkla ayağa kaldırır ve loglarını gösterir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
