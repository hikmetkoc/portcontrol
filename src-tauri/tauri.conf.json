{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortControl",
  "version": "0.2.0",
  "identifier": "com.portcontrol.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortControl",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Yerel port ve geliştirme servisi yöneticisi",
    "longDescription": "Geliştirme araçlarının açtığı yerel portları görüntüler, kullanım amaçlarını sınıflandırır ve ilgili süreçleri güvenle durdurur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
